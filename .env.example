# Copy to .env and fill in. .env is gitignored; never commit real values.
# In CI these are repository secrets of the same names, set under
# Settings → Secrets and variables → Actions.

# Google AI Studio, free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# App Password for the sender account below, not the account password.
# Generate it while signed in as that exact account:
# https://myaccount.google.com/apppasswords
# It is 16 characters; the four spaces Google shows are display only and are
# stripped on load, so pasting it verbatim works.
SMTP_PASSWORD=

# Who the digest comes from. Also the SMTP login.
MAIL_SENDER=

# Who receives it. Comma-separated for more than one.
MAIL_RECIPIENTS=
